# Copy to .env. Keep provider credentials in the backend only.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://coinchecker:coinchecker_local@localhost:55432/coinchecker
REDIS_URL=redis://localhost:56379
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Comma-separated Chrome extension IDs allowed in production. Empty permits installation origins in development only.
EXTENSION_IDS=
ETHERSCAN_API_KEY=
COINGECKO_API_KEY=
COINGECKO_API_TIER=demo
GOPLUS_ACCESS_TOKEN=
HONEYPOT_API_KEY=
# Set true only after clearing Honeypot.is permission for your production product use.
HONEYPOT_PRODUCTION_PERMISSION=false
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
PROVIDER_TIMEOUT_MS=12000
SCAN_CACHE_SECONDS=60
MONITOR_INTERVAL_SECONDS=300
RPC_LOG_LOOKBACK=500
RPC_LOG_CHUNK=500
# For distributable builds; API host permission is generated from this exact URL.
VITE_API_URL=http://localhost:3001
